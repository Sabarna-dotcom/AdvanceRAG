# =========================
# OLLAMA BGE-M3 EMBEDDINGS
# =========================
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=30

# =========================
# OLLAMA LLM
# =========================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=1500
OLLAMA_TIMEOUT=60
LLM_MAX_RETRIES=3

# =========================
# Auth
# =========================
# JWT
JWT_SECRET_KEY=super-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_UPPERCASE=true

# Session
MAX_SESSIONS_PER_USER=5
SESSION_TIMEOUT_MINUTES=60

# Security
ENABLE_2FA=false
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# =========================
# REDIS CACHE
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

CACHE_TTL_QUERY=86400
CACHE_TTL_EMBEDDING=604800
CACHE_SIMILARITY_THRESHOLD=0.95

# =========================
# POSTGRESQL DATABASE
# =========================
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5433/educational_rag
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =========================
# LOGGING & MONITORING
# =========================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/rag.log

ENABLE_METRICS=true
METRICS_PORT=9090

# =========================
# QDRANT VECTOR DATABASE
# =========================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=educational_rag
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine
QDRANT_PDF_COLLECTION=pdf_chunks
QDRANT_VIDEO_COLLECTION=video_transcripts

# =========================
# PDF CHUNKING CONFIGURATION
# =========================
PDF_CHUNK_SIZE=800
PDF_CHUNK_OVERLAP=100
PDF_PARENT_SIZE=1000
PDF_CHILD_SIZE=300

# ============ INGESTION PATHS ============
RAW_PDF_DIR=data/raw/pdfs
PROCESSED_PDF_DIR=data/processed/pdfs
RAW_AUDIO_DIR=data/raw/audios
PROCESSED_TRANSCRIPT_DIR=data/processed/audios/transcripts
RAW_VIDEO_DIR=data/raw/videos





# ===========================================================================




# =========================
# RETRIEVAL CONFIGURATION
# =========================
RETRIEVAL_TOP_K_INITIAL=20
RETRIEVAL_TOP_K_FINAL=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.6

HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3

USE_HYDE=true
USE_FUSION=true
USE_ENSEMBLE=false
FUSION_NUM_QUERIES=3
ADAPTIVE_RETRIEVAL=true

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
RERANKER_BATCH_SIZE=16


# =========================
# GUARDRAILS
# =========================
MAX_QUERY_LENGTH=500
MIN_QUERY_LENGTH=3
ENABLE_CONTENT_FILTER=true
ENABLE_PROMPT_INJECTION_DETECTION=true

ENABLE_HALLUCINATION_DETECTION=true
HALLUCINATION_THRESHOLD=0.15
ENABLE_CITATION_VALIDATION=true
ENABLE_ACADEMIC_INTEGRITY=true

RATE_LIMIT_PER_USER_HOUR=100
RATE_LIMIT_PER_USER_DAY=1000

# =========================
# EVALUATION
# =========================
ENABLE_RAGAS_EVAL=true
RAGAS_SAMPLE_RATE=0.1
RAGAS_ASYNC=true


# =========================
# APPLICATION SETTINGS
# =========================
APP_ENV=development
DEBUG=true
MAX_CHAT_HISTORY=10

# =========================
# COST TRACKING
# =========================
TRACK_COSTS=true
GROQ_COST_PER_1K_TOKENS=0.0001
EMBEDDING_COST_PER_1K=0.00002