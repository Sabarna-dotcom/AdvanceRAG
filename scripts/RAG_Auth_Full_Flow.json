{
  "info": {
    "name": "RAG API — Full Auth Flow",
    "description": "Complete flow: Register → Login → Session → Query → Follow-up → Refresh → Logout.\n\nHOW TO USE:\n1. Set the 'base_url' collection variable to your server (default: http://localhost:8000)\n2. Run requests in order 1 → 11\n3. Tokens and session_id are auto-captured via Test scripts — no manual copy-paste needed.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",      "value": "http://localhost:8000", "type": "string" },
    { "key": "access_token",  "value": "", "type": "string" },
    { "key": "refresh_token", "value": "", "type": "string" },
    { "key": "session_id",    "value": "", "type": "string" },
    { "key": "user_id",       "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 — Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Server is healthy', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 — Register New User",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"username\": \"testuser\",\n  \"password\": \"Test@1234\",\n  \"full_name\": \"Test User\"\n}"
        },
        "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    var json = pm.response.json();",
              "    pm.collectionVariables.set('user_id', json.user_id);",
              "    pm.test('User registered successfully', function () {",
              "        pm.expect(json.user_id).to.be.a('string');",
              "        pm.expect(json.email).to.eql('testuser@example.com');",
              "    });",
              "    console.log('Registered user_id:', json.user_id);",
              "} else {",
              "    console.log('Register response:', pm.response.text());",
              "    pm.test('Register failed (user may already exist — proceed to login)', function () {",
              "        pm.expect([200, 201, 400]).to.include(pm.response.code);",
              "    });",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "03 — Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test@1234\"\n}"
        },
        "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login successful', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.access_token).to.be.a('string');",
              "    pm.expect(json.refresh_token).to.be.a('string');",
              "    pm.collectionVariables.set('access_token',  json.access_token);",
              "    pm.collectionVariables.set('refresh_token', json.refresh_token);",
              "    pm.collectionVariables.set('user_id',       json.user_id);",
              "    console.log('access_token captured:', json.access_token.substring(0, 30) + '...');",
              "    console.log('user_id:', json.user_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "04 — Get My Profile (auth/me)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}}"], "path": ["auth", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Got user profile', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.user_id).to.be.a('string');",
              "    pm.expect(json.email).to.eql('testuser@example.com');",
              "    console.log('Profile:', JSON.stringify(json));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "05 — Create Session",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "body": { "mode": "raw", "raw": "" },
        "url": { "raw": "{{base_url}}/session", "host": ["{{base_url}}"], "path": ["session"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Session created', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.session_id).to.be.a('string');",
              "    pm.collectionVariables.set('session_id', json.session_id);",
              "    console.log('session_id captured:', json.session_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "06 — RAG Query (with session)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"What is biotechnology and its applications?\",\n  \"session_id\": \"{{session_id}}\",\n  \"collection\": null,\n  \"top_k\": 10,\n  \"use_self_reflection\": true\n}"
        },
        "url": { "raw": "{{base_url}}/query", "host": ["{{base_url}}"], "path": ["query"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Query returned a response', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.answer).to.be.a('string');",
              "    pm.expect(json.session_id).to.be.a('string');",
              "    pm.collectionVariables.set('session_id', json.session_id);",
              "    console.log('Answer preview:', json.answer.substring(0, 150));",
              "    console.log('has_answer:', json.has_answer);",
              "    console.log('cited_sources:', json.cited_sources ? json.cited_sources.length : 0);",
              "    console.log('cached:', json.cached);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "07 — Follow-up Question (same session)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"Can you give me examples from agriculture specifically?\",\n  \"session_id\": \"{{session_id}}\",\n  \"top_k\": 10,\n  \"use_self_reflection\": false\n}"
        },
        "url": { "raw": "{{base_url}}/query", "host": ["{{base_url}}"], "path": ["query"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Follow-up answered with session context', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.answer).to.be.a('string');",
              "    pm.expect(json.session_id).to.eql(pm.collectionVariables.get('session_id'));",
              "    console.log('Follow-up answer preview:', json.answer.substring(0, 150));",
              "    console.log('iterations:', json.iterations);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "08 — Get Session History",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": {
          "raw": "{{base_url}}/session/{{session_id}}",
          "host": ["{{base_url}}"],
          "path": ["session", "{{session_id}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Session history returned', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.exists).to.be.true;",
              "    pm.expect(json.history).to.be.an('array');",
              "    console.log('Total turns in session:', json.history.length);",
              "    console.log('restored_from_db:', json.restored_from_db);",
              "    json.history.forEach(function(turn, i) {",
              "        console.log('Turn', i+1, '[' + turn.role + ']:', turn.content.substring(0, 80));",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "09 — List My Conversations",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{base_url}}/session", "host": ["{{base_url}}"], "path": ["session"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Conversations listed', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.conversations).to.be.an('array');",
              "    console.log('Total conversations:', json.total);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "10 — Refresh Token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
        },
        "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}}"], "path": ["auth", "refresh"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Token refreshed', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.access_token).to.be.a('string');",
              "    pm.collectionVariables.set('access_token', json.access_token);",
              "    console.log('New access_token captured:', json.access_token.substring(0, 30) + '...');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "11 — Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "body": { "mode": "raw", "raw": "" },
        "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Logged out successfully', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.message).to.include('Logged out');",
              "    pm.collectionVariables.set('access_token', '');",
              "    pm.collectionVariables.set('refresh_token', '');",
              "    console.log('Tokens cleared from collection variables.');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "BONUS — Query Without Auth (anonymous)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"query\": \"What is photosynthesis?\",\n  \"top_k\": 5,\n  \"use_self_reflection\": false\n}"
        },
        "url": { "raw": "{{base_url}}/query", "host": ["{{base_url}}"], "path": ["query"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Anonymous query works', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.answer).to.be.a('string');",
              "    console.log('Anonymous session_id:', json.session_id);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "BONUS — Clear Session History",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "body": { "mode": "raw", "raw": "" },
        "url": {
          "raw": "{{base_url}}/session/{{session_id}}/clear",
          "host": ["{{base_url}}"],
          "path": ["session", "{{session_id}}", "clear"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Session history cleared', function () {",
              "    pm.response.to.have.status(200);",
              "    var json = pm.response.json();",
              "    pm.expect(json.message).to.include('cleared');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
