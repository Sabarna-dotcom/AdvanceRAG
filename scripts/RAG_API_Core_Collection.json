              "body": "{\n  \"answer\": \"Biotechnology is the use of biological systems [Source 1].\",\n  \"cited_sources\": [{\"index\": 1, \"source_type\": \"pdf\", \"title\": \"10. Biotechnology and its Application.pdf\", \"page\": 1, \"start_time\": null, \"end_time\": null, \"preview\": \"Biotechnology essentially deals with...\"}],\n  \"cited_indices\": [1],\n  \"has_answer\": true,\n  \"iterations\": 1,\n  \"reflection\": {\"overall_confidence\": 0.87},\n  \"session_id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\"\n}"
            }
