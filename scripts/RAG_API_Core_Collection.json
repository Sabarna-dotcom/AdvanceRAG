          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": { "mode": "raw", "raw": "{\n  \"query\": \"What is biotechnology?\",\n  \"collection\": \"pdf\",\n  \"top_k\": 10,\n  \"use_self_reflection\": true\n}", "options": {"raw": {"language": "json"}} },
            "url": { "raw": "{{base_url}}/query", "host": ["{{base_url}}"], "path": ["query"] },
