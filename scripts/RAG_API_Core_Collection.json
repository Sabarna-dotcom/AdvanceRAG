            "body": { "mode": "raw", "raw": "{\n  \"query\": \"Explain all applications of biotechnology in detail.\",\n  \"collection\": \"pdf\",\n  \"top_k\": 20,\n  \"use_self_reflection\": true,\n  \"session_id\": \"{{session_id}}\"\n}", "options": {"raw": {"language": "json"}} },
            "url": { "raw": "{{base_url}}/query", "host": ["{{base_url}}"], "path": ["query"] }
