{
  "info": {
    "name": "RAG API — Core (Health + Session + Query)",
    "description": "Core RAG API endpoints: Health, Session management, and Query (PDF / Audio / Both).\n\n=== SETUP ===\n1. Set base_url variable (default: http://localhost:8000)\n2. Start: docker-compose up -d qdrant redis && ollama serve\n3. Run: uvicorn src.api.app:app --reload --host 0.0.0.0 --port 8000\n\n=== QUICK START ===\n1. GET  /health         — verify services are up\n2. POST /session        — create session (auto-saved to {{session_id}})\n3. POST /query          — ask a question\n4. GET  /session/{id}   — inspect chat history\n\n=== COLLECTIONS ===\n- 'pdf'   → PDF chunks (citations: filename + page)\n- 'audio' → Transcripts (citations: title + start/end time)\n- omit    → Both collections",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string",
      "description": "Auto-populated by Create Session."
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "pm.test('status field exists', function() { pm.expect(json).to.have.property('status'); });",
                  "pm.test('qdrant field is boolean', function() { pm.expect(json.qdrant).to.be.a('boolean'); });",
                  "pm.test('ollama field is boolean', function() { pm.expect(json.ollama).to.be.a('boolean'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] },
            "description": "Check if Qdrant and Ollama are reachable. status='ok' or 'degraded'."
          },
          "response": [
            {
              "name": "200 OK — All services up",
              "status": "OK", "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n  \"status\": \"ok\",\n  \"qdrant\": true,\n  \"ollama\": true,\n  \"details\": null\n}"
            },
            {
              "name": "200 OK — Degraded (Ollama down)",
              "status": "OK", "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n  \"status\": \"degraded\",\n  \"qdrant\": true,\n  \"ollama\": false,\n  \"details\": {\"ollama_error\": \"Connection refused\"}\n}"
            }
          ]
        },
        {
          "name": "Root",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{base_url}}/", "host": ["{{base_url}}"], "path": [""] }
          },
          "response": []
        },
        {
          "name": "Swagger Docs",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{base_url}}/docs", "host": ["{{base_url}}"], "path": ["docs"] },
            "description": "Open in browser for interactive Swagger UI."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Session",
      "item": [
        {
          "name": "Create Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.session_id) {",
                  "    pm.collectionVariables.set('session_id', json.session_id);",
                  "    console.log('session_id saved:', json.session_id);",
                  "}",
                  "pm.test('Session created', function() {",
                  "    pm.expect(json.session_id).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST", "header": [],
            "url": { "raw": "{{base_url}}/session", "host": ["{{base_url}}"], "path": ["session"] },
            "description": "Create a new Redis session. session_id auto-saved to {{session_id}}."
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK", "code": 200,
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n  \"session_id\": \"a1b2c3d4-e5f6-7890-abcd-ef1234567890\",\n  \"message\": \"Session created successfully.\"\n}"
            }
          ]
        },
        {
          "name": "Get Session Info",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "pm.test('session_id matches', function() { pm.expect(json.session_id).to.equal(pm.collectionVariables.get('session_id')); });",
                  "pm.test('history is array', function() { pm.expect(json.history).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{base_url}}/session/{{session_id}}", "host": ["{{base_url}}"], "path": ["session", "{{session_id}}"] },
            "description": "Get session metadata and full chat history."
          },
          "response": []
        },
        {
          "name": "Clear Session History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "pm.test('message exists', function() { pm.expect(pm.response.json()).to.have.property('message'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST", "header": [],
            "url": { "raw": "{{base_url}}/session/{{session_id}}/clear", "host": ["{{base_url}}"], "path": ["session", "{{session_id}}", "clear"] },
            "description": "Clear history but keep session alive."
          },
          "response": []
        },
        {
          "name": "Delete Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('session_id', '');",
                  "console.log('session_id cleared.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE", "header": [],
            "url": { "raw": "{{base_url}}/session/{{session_id}}", "host": ["{{base_url}}"], "path": ["session", "{{session_id}}"] },
            "description": "Permanently delete session from Redis."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Query — PDF",
      "item": [
        {
          "name": "PDF Query — Simple (No Session)",
