            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Explain recombinant DNA technology.\",\n  \"collection\": \"pdf\",\n  \"top_k\": 10,\n  \"use_self_reflection\": false,\n  \"session_id\": \"{{session_id}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/query",
              "host": ["{{base_url}}"],
              "path": ["query"]
            },
            "description": "Self-reflection disabled — faster response, no re-generation loop.\nGood for quick lookups. reflection field will be null in response."
          },
          "response": []
        },
        {
          "name": "PDF Query — High Top K (Broad Retrieval)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Explain all applications of biotechnology in detail.\",\n  \"collection\": \"pdf\",\n  \"top_k\": 20,\n  \"use_self_reflection\": true,\n  \"session_id\": \"{{session_id}}\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{base_url}}/query",
              "host": ["{{base_url}}"],
              "path": ["query"]
            },
            "description": "Broader retrieval with top_k=20 for comprehensive questions.\nMore chunks = richer context but slower response."
          },
          "response": []
        }
      ]
    },
    {
