    {
      "name": "6. Full Conversation Flow (Run In Order)",
      "item": [
        {
          "name": "Step 1 — Create Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.session_id) {",
                  "    pm.collectionVariables.set('session_id', json.session_id);",
                  "    console.log('Step 1 — session_id saved:', json.session_id);",
                  "}",

                  "pm.test('Session created', function() {",
                  "    pm.expect(json.session_id).to.be.a('string').and.not.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/session",
              "host": ["{{base_url}}"],
              "path": ["session"]
            },
            "description": "Step 1: Create a fresh session. session_id saved to {{session_id}} automatically."
          },
          "response": []
        },
        {
          "name": "Step 2 — First Question (PDF)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Has answer', function() { pm.expect(json.has_answer).to.be.true; });",
                  "pm.test('Has cited sources', function() { pm.expect(json.cited_sources.length).to.be.above(0); });",
                  "pm.test('Has session_id', function() { pm.expect(json.session_id).to.be.a('string'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
