# =========================
# HUGGINGFACE EMBEDDINGS
# =========================
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=30

# =========================
# GROQ LLM
# =========================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1500
GROQ_TIMEOUT=60

# =========================
# PINECONE VECTOR DATABASE
# =========================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=educational-rag
PINECONE_DIMENSION=1024
PINECONE_METRIC=cosine
PINECONE_NAMESPACE_PDF=pdf-chunks
PINECONE_NAMESPACE_VIDEO=video-transcripts

# =========================
# REDIS CACHE
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

CACHE_TTL_QUERY=86400
CACHE_TTL_EMBEDDING=604800
CACHE_SIMILARITY_THRESHOLD=0.95

# =========================
# POSTGRESQL DATABASE
# =========================
DATABASE_URL=postgresql://username:password@localhost:5432/rag_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# =========================
# RETRIEVAL CONFIGURATION
# =========================
RETRIEVAL_TOP_K_INITIAL=20
RETRIEVAL_TOP_K_FINAL=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.6

HYBRID_VECTOR_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3

USE_HYDE=true
USE_FUSION=true
USE_ENSEMBLE=false
FUSION_NUM_QUERIES=3
ADAPTIVE_RETRIEVAL=true

RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
RERANKER_BATCH_SIZE=16

# =========================
# CHUNKING CONFIGURATION
# =========================
PDF_CHUNK_SIZE=800
PDF_CHUNK_OVERLAP=100
PDF_ENABLE_PARENT_CHILD=true
PDF_PARENT_SIZE=1000
PDF_CHILD_SIZE=300

VIDEO_CHUNK_DURATION=180
VIDEO_MIN_CHUNK_LENGTH=50
VIDEO_ENABLE_PARENT_CHILD=true

# =========================
# GUARDRAILS
# =========================
MAX_QUERY_LENGTH=500
MIN_QUERY_LENGTH=3
ENABLE_CONTENT_FILTER=true
ENABLE_PROMPT_INJECTION_DETECTION=true

ENABLE_HALLUCINATION_DETECTION=true
HALLUCINATION_THRESHOLD=0.15
ENABLE_CITATION_VALIDATION=true
ENABLE_ACADEMIC_INTEGRITY=true

RATE_LIMIT_PER_USER_HOUR=100
RATE_LIMIT_PER_USER_DAY=1000

# =========================
# EVALUATION
# =========================
ENABLE_RAGAS_EVAL=true
RAGAS_SAMPLE_RATE=0.1
RAGAS_ASYNC=true

# =========================
# LOGGING & MONITORING
# =========================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/rag.log

ENABLE_METRICS=true
METRICS_PORT=9090

# =========================
# APPLICATION SETTINGS
# =========================
APP_ENV=development
DEBUG=true
MAX_CHAT_HISTORY=10

# =========================
# COST TRACKING
# =========================
TRACK_COSTS=true
GROQ_COST_PER_1K_TOKENS=0.0001
EMBEDDING_COST_PER_1K=0.00002